# SuperDocs API key — get yours at use.superdocs.app → Settings → API Keys
# Redeem promo code BUILDER26 in Settings → Billing first (10,000 free ops)
SUPERDOCS_API_KEY=sk_YOUR_API_KEY_HERE

# Database
DATABASE_URL=postgresql://doctask:doctask@localhost:5432/doctask

# App
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ENVIRONMENT=development

# LLM — Groq (free tier, 280 tok/s on llama-3.3-70b-versatile)
# Get a free key at console.groq.com
GROQ_API_KEY=
# Optional: comma-separated list for key rotation across concurrent requests
# GROQ_API_KEYS=key1,key2,key3

# Embeddings — OpenAI text-embedding-3-small (1536 dims, matches pgvector column)
# Used for RAG context injection in the extract node and the /api/search endpoints.
# Leave blank to run without embeddings; the pipeline degrades gracefully:
# similarity search returns [] and extraction runs without RAG context.
OPENAI_API_KEY=

# Frontend dev server
VITE_API_BASE=http://localhost:8000
